# ---------------- Godot ----------------
.godot/
*.translation

# ---------------- .NET ----------------
bin/
obj/
*.user

# ---------------- 导出产物 ----------------
build/
dist/
*.pck
export_credentials.cfg

# ---------------- 备份文件 ----------------
# 开发过程中手动备份的历史版本，共 190+ 个，不进仓库
*.bak
*.bak[0-9]*

# ---------------- 音频素材 ----------------
# 音频已纳入仓库（音效 + BGM）。
# 例外：m4a 不支持（Godot 只认 wav / mp3 / ogg），不入库。
*.m4a

# ---------------- 音频分析与试听 ----------------
# tools/ref 存放从参考录屏中抽取的音频，tools/preview_audio 是试听产物
tools/ref/
tools/preview_audio/

# ---------------- 素材工作区中间产物 ----------------
# tools/_art/ 是素材生产现场：预览图、AI 生成原稿、分色/抠图中间稿、对比图。
# 最终素材在 assets/ 下，中间产物靠脚本可重跑，不进仓库。
tools/_art/**/*.png
tools/_art/**/*.jpg

# ---------------- 开发过程截图 ----------------
# docs/screenshots/ 是调试抓手（无头探针抓帧、局部放大比对），目前 340+ 张，不进仓库。
# README 引用的成品图在 screenshots/ 下，那一份要提交。
docs/screenshots/

# 视频剪辑工作目录（中间片段、抽帧检查图），成品放 dist/
docs/video/

# ---------------- 系统 ----------------
Thumbs.db
desktop.ini
.DS_Store

# 图标生成中间产物（可由 ffmpeg 从 pixel-128-transparent.png 重新生成）
tools/icon/

# 精灵表生成的中间产物（.py 脚本保留，可复现）
tools/applemon/*.raw
tools/applemon/*.rgba

tools/crouch/*.raw
