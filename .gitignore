# ---------------- Godot ----------------
.godot/
*.translation

# ---------------- .NET ----------------
bin/
obj/
*.user

# ---------------- 导出产物 ----------------
build/
dist/
*.pck
export_credentials.cfg

# ---------------- 备份文件 ----------------
