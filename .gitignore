# ---------------- Godot ----------------
.godot/
*.translation

# ---------------- .NET ----------------
bin/
obj/
*.user

# ---------------- 导出产物 ----------------
build/
*.pck
export_credentials.cfg

# ---------------- 备份文件 ----------------
# 开发过程中手动备份的历史版本，共 190+ 个，不进仓库
*.bak
*.bak[0-9]*

# ---------------- 音频素材 ----------------
# 音效与 BGM 均为第三方来源（音效库 / 录屏截取），
# 为规避版权问题不放入公开仓库。游戏在本地可正常运行，
# 克隆后如需听声音，请自行在下列目录放入同名音频文件：
#   assets/audio/sfx/<名字>.wav|mp3|ogg
#   assets/audio/bgm/<名字>.mp3|ogg
# 对话打字音可以用 tools/gen_blip.py 重新合成一个。
assets/audio/

# ---------------- 音频分析与试听 ----------------
# tools/ref 存放从参考录屏中抽取的音频，tools/preview_audio 是试听产物
tools/ref/
tools/preview_audio/

# ---------------- 系统 ----------------
Thumbs.db
desktop.ini
.DS_Store
