[node name="OldApple" parent="." unique_id=423994948 instance=ExtResource("12_oldapple")]
position = Vector2(560, 356)
FirstLines = PackedStringArray("npc:……哦？好久没见过活人走进这间屋子了。", "me:卧槽苹果！！！", "npc:别那么大惊小怪的", "npc:我可不会伤人", "me:这样吗真奇怪", "npc:哈哈哈哈哈哈哈", "npc:你可有什么问题问我吗")
TopicTitles = PackedStringArray("外面的苹果灾是怎么回事啊！！", "这里的果子为什么这么吓人呢？", "为什么你不会伤人", "你能帮我解决苹果灾吗")
Topic1Lines = PackedStringArray("npc:这可说来话长了", "npc:其实我们都是伊甸园里善恶树的果子", "npc:想当初亚当和夏娃被蛇蛊惑，吃下了果子", "npc:才有了人类", "npc:如今那蛇不满人类发展到今天的地步", "npc:回到了果树下，不断地将果子甩下人间，还混入了他的邪气", "npc:这才导致了这场苹果灾啊", "me:沃德发。。。")
Topic2Lines = PackedStringArray("npc:哈哈哈哈哈哈哈", "npc:这也是你们人间的问题呀", "npc:这片热带雨林细菌太多了", "npc:果子们来到这不久就被腐蚀成现在的样子了", "又因为抗邪气的外表皮没了", "npc:变得更加邪恶恐怖了呢", "me:那你怎么没事啊？？", "npc:哈哈哈哈哈哈哈哈哈哈", "npc:这间房子原是个巨大的鹅颈瓶，大概是个试验基地吧", "npc:细菌可进不来这种地方", "me:纳尼？？？！！！", "me:你懂的还挺多。。", "me:那你是怎么进来的？", "npc:我既然都是天上的果子了", "npc:当然是靠法力进来的")
Topic3Lines = PackedStringArray("npc:在树上我也算是个老家伙了", "npc:论修为也能当个长老", "npc:那点邪气对我算不上什么", "me:那你也很厉害了")
Topic4Lines = PackedStringArray("npc:这到底是你们人类的灾祸", "npc:自然需要你们人类去解决", "me:。。。。。。。。。。", "npc：别灰心", "npc:再往前走走有我之前留下的魔茎，你往上爬可以去到天界", "npc:只要解决了那只蛇，苹果灾也就结束了", "me:听上去并不容易啊喂。")

