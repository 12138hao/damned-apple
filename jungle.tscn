[node name="AppleFairy" type="CharacterBody2D" parent="." unique_id=1644444773]
position = Vector2(16300, 210)
collision_layer = 4
collision_mask = 2
script = ExtResource("90_fairy")
FirstLines = PackedStringArray("npc:你好呀，我是老苹果创造的苹果仙子", "npc:我的使命是看护这个巨茎", "me:哇原来是这样，那你能送我上去吗", "npc:没问题！", "npc:但是前面的区域很危险，我需要对你进行测试", "npc:如果你能通过测挑战的话我就送你上去", "me:放马过来吧！")
BattleMenuTitles = PackedStringArray("开启挑战", "我还要再准备一下")
